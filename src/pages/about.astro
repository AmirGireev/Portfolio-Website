---
/** About page */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import TypingEffect from '@/components/ui/TypingEffect.astro';
---
<PageLayout
  title="About Amir Gireev"
  description="About Amir Gireev, Media & Computer Science Student."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="user" size="sm" />
      About me
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Amir Gireev —</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">
        <TypingEffect words={["Web Developer", "Game Developer", "AI Engineer"]} />
      </span>
    </h1>
  </Hero>
  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-2xl px-6 text-center" data-reveal>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">
        My CV
      </h2>
      <Button size="lg" href="/CV_Amir_Gireev.pdf" download="CV_Amir_Gireev.pdf">
        Download
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </section>

  <section class="py-[var(--space-section-md)] bg-brand-500/8 dark:bg-background-secondary">
  <div class="mx-auto max-w-3xl px-6">
    <div class="flex flex-col gap-4 items-center text-center" data-reveal>
      <div class="flex flex-col gap-6">
        <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">
              What I look for
            </h2>
          </div>
          <p class="text-lg text-foreground-muted leading-relaxed">
           I am seeking an internship to put my knowledge into practice.
           I am looking to level up my skills, contribute to meaningful projects, and learn from a professional tech team.
           My Internship should start in March/April 2027 and is supposed to last for at least 4 months.
          </p>
        </div>
      </div>
  </section>
  <!-- Values -->
  <section class="py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center flex flex-col items-center gap-4" data-reveal>
        <div class="flex flex-col items-center gap-6">
          <h2 class="font-display text-4xl font-bold text-foreground">
            My Skills
          </h2>
        </div>
      </div>
      <div class="grid gap-8 md:grid-cols-3" data-reveal data-reveal-delay="1">
        <Card hover>
          <div class="flex items-start gap-4">
            
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Programming Languages</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                TypeScript, JavaScript, Python, SQL, C++, C#
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Game Engines / 3D Modeling</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Unity, Unreal Engine, Maya/Blender
              </p>
            </div>
          </div>
        </Card>
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-foreground">Tools &amp; Technologies</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                React, Next.js, Three.js, HTML5, CSS3 / Tailwind CSS, Django, PostgreSQL, Redis, Docker, CI/CD, LLM / RAG Pipelines, Testing (pytest, Jest / Vitest)
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>
</PageLayout>
