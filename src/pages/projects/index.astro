---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);

const categories = [
  {
    slug: 'ai-backend',
    title: 'AI & Backend',
    description: 'RAG systems, LLM tools, backend services, and API developments.',
    count: allProjects.filter((p) => p.data.category === 'ai-backend').length,
  },
  {
    slug: 'graphics-gamedev',
    title: 'Graphics & Game Dev',
    description: '3D modeling, computer graphics, shaders, and raytracers.',
    count: allProjects.filter((p) => p.data.category === 'graphics-gamedev').length,
  },
];
---

<PageLayout title="Projects" description="Select a category" eagerReveal>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      Categories
    </Badge>
    <h1 slot="title">Projects</h1>
  </Hero>

  <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="grid gap-6 md:grid-cols-2" data-reveal>
        {categories.map((cat) => (
          <Card variant="elevated" hover padding="lg" href={`/projects/${cat.slug}`} class="group flex flex-col justify-between">
            <div>
              <div class="mb-4 flex items-center justify-between">
                 <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500">
                  <Icon name="layers" size="md" />
                </div>
                <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors" />
              </div>
              <h2 class="font-display text-xl font-bold text-foreground mb-2">{cat.title}</h2>
              <p class="text-sm text-foreground-muted leading-relaxed mb-6">{cat.description}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>
</PageLayout>