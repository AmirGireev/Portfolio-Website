{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts", 
    "src/**/*", 
    "src/env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "src/pages/components.astro"]
}